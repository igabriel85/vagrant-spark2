# Static cluster names, written first on both VMs. There is deliberately no "127.0.1.1 <hostname>"
# line, so node1/prometheus resolve to their private IPs and Spark and Dask bind there.
$etc_hosts_script = <<'SCRIPT'
#!/bin/bash
cat > /etc/hosts <<EOF
127.0.0.1       localhost
192.168.56.10   prometheus
192.168.56.2    node1
# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF
SCRIPT


$master_script = <<'SCRIPT'
#!/bin/bash
set -e
export DEBIAN_FRONTEND=noninteractive
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

PROMETHEUS_VERSION=3.13.5
ARCH=$(dpkg --print-architecture)   # amd64 or arm64

apt-get update
apt-get install -y wget curl gpg ca-certificates

# Download Prometheus
wget -q https://github.com/prometheus/prometheus/releases/download/v${PROMETHEUS_VERSION}/prometheus-${PROMETHEUS_VERSION}.linux-${ARCH}.tar.gz -O /tmp/prometheus.tar.gz
tar -xzf /tmp/prometheus.tar.gz -C /opt
rm /tmp/prometheus.tar.gz
ln -sfn /opt/prometheus-${PROMETHEUS_VERSION}.linux-${ARCH} /opt/prometheus

cat <<EOF > /opt/prometheus/prometheus.yml
global:
  scrape_interval:     1s # By default, scrape targets every 15 seconds.
  # Attach these labels to any time series or alerts when communicating with
  # external systems (federation, remote storage, Alertmanager).
  external_labels:
    monitor: 'aspide-monitor'
# A scrape configuration containing exactly one endpoint to scrape:
# Here it's the node_exporter on node1.
scrape_configs:
  # The job name is added as a label `job=<job_name>` to any timeseries scraped from this config.
  - job_name: 'node-prometheus'
    static_configs:
      - targets: ['192.168.56.2:9100']
EOF
chown -R vagrant:vagrant /opt/prometheus-${PROMETHEUS_VERSION}.linux-${ARCH}

# Register prometheus as service (restart so a re-provision picks up the new config)
cp /vagrant/prometheus.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable prometheus.service
systemctl restart prometheus.service

# Install grafana from the Grafana apt repo (resolves dependencies and the CPU architecture)
mkdir -p /etc/apt/keyrings
wget -qO- https://apt.grafana.com/gpg.key | gpg --dearmor --yes -o /etc/apt/keyrings/grafana.gpg
echo "deb [signed-by=/etc/apt/keyrings/grafana.gpg] https://apt.grafana.com stable main" > /etc/apt/sources.list.d/grafana.list
apt-get update
apt-get install -y grafana-enterprise

# Start grafana service and run on every boot
systemctl daemon-reload
systemctl enable --now grafana-server

# Set Swappiness value to 10 instead of 60
sysctl -w vm.swappiness=10
echo "vm.swappiness=10" > /etc/sysctl.d/99-swappiness.conf
SCRIPT


$hosts_script = <<'SCRIPT'
#!/bin/bash
set -e
export DEBIAN_FRONTEND=noninteractive
export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

NODE_EXPORTER_VERSION=1.12.1
ARCH=$(dpkg --print-architecture)   # amd64 or arm64

apt-get update
apt-get install -y wget git redis-server

# Download node_exporter
wget -q https://github.com/prometheus/node_exporter/releases/download/v${NODE_EXPORTER_VERSION}/node_exporter-${NODE_EXPORTER_VERSION}.linux-${ARCH}.tar.gz -O /tmp/node_exporter.tar.gz
tar -xzf /tmp/node_exporter.tar.gz -C /opt
rm /tmp/node_exporter.tar.gz
ln -sfn /opt/node_exporter-${NODE_EXPORTER_VERSION}.linux-${ARCH} /opt/node_exporter
chown -R vagrant:vagrant /opt/node_exporter-${NODE_EXPORTER_VERSION}.linux-${ARCH}
cp /vagrant/node_exporter.service /etc/systemd/system/

# Clone UNICAL Use-Case
mkdir -p /opt/unical
[ -d /opt/unical/AUDESOME ] || git clone https://github.com/SCAlabUnical/AUDESOME.git /opt/unical/AUDESOME

# Install Chaos inducer in its own env: its requirements pin old packages (markupsafe 2.0.1)
# and the code imports rq.Connection, which was removed in rq 2.
[ -d /opt/ede-chaos-inductor ] || git clone https://github.com/IeAT-ASPIDE/ede-chaos-inductor.git /opt/ede-chaos-inductor
[ -d /opt/conda/envs/chaos ] || /opt/conda/bin/conda create -y -n chaos python=3.10 pip
/opt/conda/envs/chaos/bin/pip install -r /opt/ede-chaos-inductor/requirements.txt "rq<2"

# The upstream units run /opt/conda/bin/python; point them at the chaos env
for unit in chaosrqworker@.service eci@.service; do
    sed 's#/opt/conda/bin/python#/opt/conda/envs/chaos/bin/python#' /opt/ede-chaos-inductor/etc/systemd/$unit > /etc/systemd/system/$unit
done
chown -R vagrant:vagrant /opt/unical /opt/ede-chaos-inductor

# Template units need an instance name: eci@1 is the REST API (port 5000), chaosrqworker@1 the job worker
systemctl daemon-reload
systemctl enable redis-server node_exporter eci@1 chaosrqworker@1
systemctl restart redis-server node_exporter eci@1 chaosrqworker@1

# Set Swappiness value to 10 instead of 60 (persisted by provision_script.sh)
sysctl -w vm.swappiness=10
SCRIPT


# Spark master + worker, Dask scheduler + worker and JupyterLab, all on node1 as systemd services
# so they come back after `vagrant halt`/`vagrant up` and `vagrant reload`.
$cluster_script = <<'SCRIPT'
#!/bin/bash
set -e
for unit in spark-master spark-worker dask-scheduler dask-worker jupyter; do
    cp /vagrant/$unit.service /etc/systemd/system/
done
systemctl daemon-reload
systemctl enable spark-master spark-worker dask-scheduler dask-worker jupyter
systemctl restart spark-master spark-worker dask-scheduler dask-worker jupyter
SCRIPT

Vagrant.configure("2") do |config|

  # Ubuntu 24.04 LTS, same box as ../Vagrantfile; has amd64 and arm64 (Apple Silicon) builds
  config.vm.box = "bento/ubuntu-24.04"

  config.vm.define :master do |master|
    master.vm.provider :virtualbox do |v|
      v.name = "prometheus_bd"
      v.customize ["modifyvm", :id, "--memory", "2048"]
    end
    # Not 192.168.56.1: that is the host's own address on the VirtualBox host-only network
    master.vm.network :private_network, ip: "192.168.56.10"
    master.vm.hostname = "prometheus"
    master.vm.network :forwarded_port, host:9090, guest: 9090
    master.vm.network :forwarded_port, host:3000, guest: 3000
    master.vm.network :forwarded_port, guest: 22, host: 2185
    master.vm.provision :shell, :inline => $etc_hosts_script
    master.vm.provision :shell, :inline => $master_script
  end

  config.vm.define :slave1 do |slave1|
    slave1.vm.provider :virtualbox do |v|
      v.name = "unical_bd_node1"
      v.customize ["modifyvm", :id, "--memory", "6144"]
      v.customize ["modifyvm", :id, "--cpus", 4]
    end
    # Keep 192.168.56.2: bd_lab.ipynb queries Prometheus for instance="192.168.56.2:9100"
    slave1.vm.network :private_network, ip: "192.168.56.2"
    slave1.vm.hostname = "node1"
    slave1.vm.network :forwarded_port, guest: 22, host: 2186
    slave1.vm.network :forwarded_port, guest: 5000, host: 5001
    slave1.vm.network :forwarded_port, guest: 8888, host: 8897
    slave1.vm.network :forwarded_port, guest: 8080, host: 8082
    slave1.vm.network :forwarded_port, guest: 8081, host: 8083
    slave1.vm.network :forwarded_port, guest: 4040, host: 4041
    slave1.vm.network :forwarded_port, guest: 18080, host: 18081
    slave1.vm.network :forwarded_port, guest: 8787, host: 8787
    slave1.vm.provision :shell, :inline => $etc_hosts_script
    slave1.vm.provision :shell, path: "provision_script.sh"
    slave1.vm.provision :shell, :inline => $hosts_script
    slave1.vm.provision :shell, :inline => $cluster_script
  end
end